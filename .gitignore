# =============================================================================
#  BakuganDOTCRecomp - .gitignore
#  Solo se versionan fuentes propias, manifiesto, scripts, docs y licencias.
#  NUNCA se suben archivos del juego, código recompilado ni binarios.
# =============================================================================

# -----------------------------------------------------------------------------
# Archivos originales del juego (Xbox 360) - deben quedarse en local
# -----------------------------------------------------------------------------
*.xex
*.iso
*.dat
*.god
*.xzp
*.xcp
*.stfs
default.xex
/game/
/assets/
/bakugan_tm__dotc/
/Bakugan_TM__DOTC/

# -----------------------------------------------------------------------------
# Bases de ingeniería inversa (IDA Pro, Ghidra, Binary Ninja)
# -----------------------------------------------------------------------------
*.i64
*.idb
*.id0
*.id1
*.id2
*.id3
*.nam
*.til
*.$$$
*.gpr
*.rep/
*.bndb
ida_*.json

# -----------------------------------------------------------------------------
# Código generado por ReXGlue / XenonRecomp (derivado del XEX)
# Se regenera con scripts/Build.ps1 a partir de la copia del usuario.
# -----------------------------------------------------------------------------
/generated/
recompile.log
ppc_context.h
ppc_recomp*.cpp
ppc_func_mapping.cpp

# -----------------------------------------------------------------------------
# SDK de terceros (se obtiene por separado, ver docs/DEPENDENCIES.md)
# -----------------------------------------------------------------------------
/rexglue-sdk-src/
/rexglue-sdk/
/thirdparty/
/sdk/
/tools/
gamecontrollerdb.txt

# -----------------------------------------------------------------------------
